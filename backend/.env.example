PORT=5001
NODE_ENV=development

# MongoDB Connection String (Real persistent instance required: Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/immigration_dossier_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/immigration_dossier_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/immigration_dossier_db

FRONTEND_URL=http://localhost:3001
JWT_SECRET=dev_jwt_secret_immigration_dossier_secure_key_12345
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=dev_refresh_secret_immigration_dossier_secure_key_67890
REFRESH_TOKEN_EXPIRES_IN=7d
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
AI_API_KEY=
